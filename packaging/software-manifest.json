    {"id": "dotgothic16", "tier": "font", "source": "ofl-fetch", "debian": null, "freebsd": null, "category": "font", "description": "Japanese pixel display font (fetched via scripts/fetch-fonts.sh, OFL)"},
    {"id": "zen-dots", "tier": "font", "source": "ofl-fetch", "debian": null, "freebsd": null, "category": "font", "description": "Display accent font (fetched via scripts/fetch-fonts.sh, OFL)"}
