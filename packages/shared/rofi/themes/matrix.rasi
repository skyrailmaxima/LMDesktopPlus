/* LMDesktopPlus vapor//matrix rofi theme */
* {
  bg:       #05060a;
  bg-alt:   #0b0817;
  fg:       #8dffbe;
  selected: #ff2e97;
  border:   #01cdfe;
  active:   #05ffa1;

  background-color: transparent;
  text-color:        @fg;
}

window {
  background-color: @bg;
  border:            2px;
  border-color:      @border;
  border-radius:     6px;
  padding:           8px;
  width:             560px;
}

mainbox {
  background-color: transparent;
  children: [ inputbar, listview ];
  spacing: 8px;
}

inputbar {
  background-color: @bg-alt;
  text-color:        @fg;
  border:            1px;
  border-color:      @border;
  border-radius:     4px;
  padding:           8px;
  children: [ prompt, entry ];
}

prompt {
  text-color: @selected;
}

entry {
  text-color:        @fg;
  placeholder-color: @fg;
  placeholder:       "Search...";
}

listview {
  background-color: transparent;
  columns:            1;
  lines:              8;
  spacing:            4px;
  cycle:              true;
  dynamic:            true;
  scrollbar:          false;
}

element {
  background-color: transparent;
  text-color:        @fg;
  padding:           6px 8px;
  border-radius:     4px;
}

element selected {
  background-color: @selected;
  text-color:        #ffffff;
  border:            1px;
  border-color:      @border;
}

element-text {
  background-color: inherit;
  text-color:        inherit;
}

element-icon {
  background-color: inherit;
  size:              1.2em;
}
