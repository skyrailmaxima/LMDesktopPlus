// LMDesktopPlus vapor//matrix waybar config
{
  "layer": "top",
  "position": "top",
  "height": 32,
  "spacing": 4,
  "margin-top": 6,
  "margin-left": 10,
  "margin-right": 10,

  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["clock"],
  "modules-right": ["cpu", "memory", "network", "custom/exit", "tray"],

  "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "persistent-workspaces": {
      "1": [],
      "2": [],
      "3": [],
      "4": []
    }
  },

  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%Y-%m-%d %H:%M:%S}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
  },

  "cpu": {
    "format": " {usage}%",
    "interval": 2,
    "tooltip": true
  },

  "memory": {
    "format": " {percentage}%",
    "interval": 5,
    "tooltip-format": "{used:0.1f}GiB / {total:0.1f}GiB used"
  },

  "network": {
    "format-wifi": " {essid} ({signalStrength}%)",
    "format-ethernet": " {ifname}",
    "format-disconnected": "⚠ offline",
    "tooltip-format": "{ifname}: {ipaddr}/{cidr}"
  },

  "custom/exit": {
    "format": "EXIT",
    "tooltip": "Exit Hyprland (Super+E). Super+Shift+E exits immediately.",
    "on-click": "~/.config/hypr/scripts/exit-menu.sh"
  },

  "tray": {
    "icon-size": 16,
    "spacing": 8
  }
}
